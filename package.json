{
  "name": "forgex",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:archetype": "tsx scripts/check-archetype.ts",
    "data:students": "tsx scripts/import-students.ts",
    "data:profiles": "tsx scripts/import-profiles.ts",
    "data:archetypes": "tsx scripts/import-archetypes.ts",
    "sheet:init": "node --env-file=.env.local --conditions=react-server --import tsx scripts/sheet-init.ts",
    "sheet:problems": "node --env-file=.env.local --conditions=react-server --import tsx scripts/sheet-init.ts --problems",
    "art:relics": "node scripts/render-relics.mjs",
    "shoot": "node scripts/shoot.mjs",
    "research": "tsx scripts/research/run.ts",
    "research:collect": "tsx scripts/research/collect-hn.ts && tsx scripts/research/collect-fixmyitch.ts && tsx scripts/research/collect-yc.ts",
    "research:signal": "tsx scripts/research/add-signal.ts",
    "research:validate": "tsx scripts/research/validate.ts",
    "bank:list": "tsx scripts/research/list.ts",
    "bank:lint": "tsx scripts/research/lint-bank.ts",
    "sheet:sync": "node --env-file=.env.local --conditions=react-server --import tsx scripts/sheet-init.ts --problems --sync"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "xlsx": "^0.18.5"
  }
}
