# Auth.js: `npx auth secret` makes one. Google OAuth client from Cloud Console.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Sheet and the service account that writes to it (share the Sheet with
# GOOGLE_SA_EMAIL as Editor). Paste the key with its \n escapes intact.
SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# Response emails (Phase 9)
RESEND_API_KEY=
EMAIL_FROM=

# After this moment, picks are read-only. ISO 8601 with an offset.
PICKS_CLOSE_AT=2026-11-01T23:59:00+05:30

# Memory instead of the Sheet, plus a password-less sign-in. Ignored on a
# Vercel production deploy whatever it says here.
MOCK_BACKEND=false

# Research pipeline only. Optional.
ANTHROPIC_API_KEY=
