# Auth.js: `npx auth secret` makes one. Google OAuth client from Cloud Console.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Sheet and the service account that writes to it (share the Sheet with
# GOOGLE_SA_EMAIL as Editor). Paste the key with its \n escapes intact.
SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# The site's own address, for share links and the founder card's preview.
# On Vercel it falls back to the deploy's own URL if this is empty.
NEXT_PUBLIC_SITE_URL=

# Every date of the hackathon (opens, problems close, the bank, each stage)
# lives in lib/hackathon.ts, not here: change it there and redeploy.

# Memory instead of the Sheet, plus a password-less sign-in. Ignored on a
# Vercel production deploy whatever it says here.
MOCK_BACKEND=false

# Mock mode only: pins the clock, to stand on any hour of the event.
# PLAN_NOW=2026-10-17T12:00:00+05:30

# Research pipeline only. Optional.
ANTHROPIC_API_KEY=
