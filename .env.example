# Auth.js: `npx auth secret` makes one. Google OAuth client from Cloud Console.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Sheet and the service account that writes to it (share the Sheet with
# GOOGLE_SA_EMAIL as Editor). Paste the key with its \n escapes intact.
SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# Response emails (Phase 9)
RESEND_API_KEY=
EMAIL_FROM=

# Every date of the sprint (launch, workshops, the 3 stops) lives in lib/plan.ts.

# The old problem bank: off. Its data stays in the Sheet. Set to `on` to read it in the console.
PROBLEM_BANK=off

# Mock mode only: pin the plan's clock to any moment, to walk a given day.
# PLAN_NOW=2026-10-14T10:00:00+05:30

# Memory instead of the Sheet, plus a password-less sign-in. Ignored on a
# Vercel production deploy whatever it says here.
MOCK_BACKEND=false

# Research pipeline only. Optional.
ANTHROPIC_API_KEY=
